# Normalise text to LF in the repo regardless of the checkout platform.
# Without this, Git for Windows can commit CRLF and the shipped byte counts drift.
* text=auto eol=lf

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.md     text eol=lf
CNAME    text eol=lf

# Binary: never diffed, never line-ending-converted.
*.woff2  binary
*.png    binary
*.webp   binary
*.jpg    binary
*.ico    binary
